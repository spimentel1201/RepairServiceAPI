# -------------------------------------------------------------------
# Repair Service API - variables de entorno
# Copia este archivo a .env y completa los valores.
# .env esta en .gitignore: NUNCA se sube a git.
# -------------------------------------------------------------------

# --- Obligatorias ---

# Conexion a PostgreSQL (Neon, Supabase, Vercel Postgres o local).
# Local:  postgresql://user:password@localhost:5432/repairdb
# Nube:   incluye siempre sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/repairdb"

# Secreto con el que se firman los JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-este-secreto"

# --- Opcionales ---

# Puerto HTTP del proceso local. Defecto: 3000
# PORT=3000

# production | development | test. En production se silencian
# los logs de queries de Prisma.
# NODE_ENV=production

# Duracion del token JWT. Defecto: 1d
# JWT_EXPIRATION=1d

# Habilita POST /auth/register. Defecto: true.
# En produccion conviene false: los usuarios se crean con `npm run seed`.
# REGISTRATION_ENABLED=true

# Allowlist de CORS separada por comas.
# Sin configurar se refleja el origen de la peticion.
# CORS_ORIGINS=https://app.ejemplo.com,https://admin.ejemplo.com

# Muestra la documentacion en /api/docs.
# Defecto: activo fuera de production, oculto en production.
# ENABLE_SWAGGER=false

# --- Solo para `npm run seed` (crea el usuario ADMIN) ---

# Obligatorias para el seed:
# ADMIN_EMAIL=admin@taller.com
# ADMIN_PASSWORD=contrasea-segura-min-6-caracteres
# Opcionales (tienen valores por defecto):
# ADMIN_FIRST_NAME=Administrador
# ADMIN_LAST_NAME=Sistema
# ADMIN_PHONE=
